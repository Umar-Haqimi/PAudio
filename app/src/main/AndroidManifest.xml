<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions (SPEC §6): the app MUST NOT declare INTERNET, BLUETOOTH_CONNECT, READ_MEDIA_AUDIO,
        READ_EXTERNAL_STORAGE, any location permission or REQUEST_IGNORE_BATTERY_OPTIMIZATIONS.
        `./gradlew :app:verifyPermissions` enforces this on the merged release manifest.
        Allowed (added by the milestone that needs them): MODIFY_AUDIO_SETTINGS, FOREGROUND_SERVICE,
        FOREGROUND_SERVICE_SPECIAL_USE, POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED, RECORD_AUDIO (optional).
    -->

    <!-- Media3 merges these two in; PAudio does not need them (verifyPermissions allow-list enforces it). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <application
        android:name=".PAudioApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PAudio">
        <!-- Exported by androidx.profileinstaller (pulled in transitively by Compose); not needed. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PAudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
